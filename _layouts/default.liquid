<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = '/' | relative_url %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>
  <body class="site-body">
    <a class="skip-link" href="#main-content">Skip to content</a>
    {% include header.liquid %}
    {% assign content_width = page.content_width | default: layout.content_width | default: 'reading' %}
    <main id="main-content" class="site-main site-container site-main--{{ content_width }}" tabindex="-1">
      {% if page.toc.sidebar %}
        <div class="content-with-sidebar">
          <aside class="content-sidebar" aria-label="On this page">
            <nav id="toc-sidebar" aria-label="Table of contents"></nav>
          </aside>
          <div class="content-body">{{ content }}</div>
        </div>
      {% else %}
        {{ content }}
      {% endif %}
    </main>
    {% include footer.liquid %}
    <script src="{{ '/assets/js/navigation.js' | relative_url | bust_file_cache }}" defer></script>
    {% include scripts.liquid %}
  </body>
</html>
