---
layout: default
content_width: wide
---
{% include page-heading.liquid %}
{% if page.cv_pdf %}
  {% assign cv_pdf = page.cv_pdf %}
  {% unless cv_pdf contains '://' %}{% assign cv_pdf = cv_pdf | prepend: 'assets/pdf/' | relative_url %}{% endunless %}
  <p><a href="{{ cv_pdf }}">Download CV (PDF)</a></p>
{% endif %}
<div class="resume-layout">
  <nav class="resume-nav" aria-label="CV sections">
    <ul>
      {% for section in site.jsonresume %}
        {% assign entries = site.data.resume[section] %}
        {% if entries and entries.size > 0 %}
          <li>
            <a href="#{{ section }}">{{ section | capitalize }}</a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </nav>
  <div>
    {% for section in site.jsonresume %}
      {% assign entries = site.data.resume[section] %}
      {% if entries and entries.size > 0 %}
        <section class="resume-section" id="{{ section }}" aria-labelledby="{{ section }}-heading">
          <h2 id="{{ section }}-heading">{{ section | capitalize }}</h2>
          {% case section %}
            {% when 'basics' %}
              <p>{{ entries.label }}</p>
              <p>{{ entries.summary }}</p>
              <dl class="resume-details">
                {% if entries.email and entries.email != '' %}
                  <dt>Email</dt>
                  <dd>
                    <a href="mailto:{{ entries.email }}">{{ entries.email }}</a>
                  </dd>
                {% endif %}
                {% if entries.phone and entries.phone != '' %}
                  <dt>Phone</dt>
                  <dd>
                    <a href="tel:{{ entries.phone | remove: ' ' }}">{{ entries.phone }}</a>
                  </dd>
                {% endif %}
                {% if entries.location.city %}
                  <dt>Location</dt>
                  <dd>
                    {{ entries.location.city -}}
                    {%- if entries.location.countryCode %}, {{ entries.location.countryCode }}{% endif %}
                  </dd>
                {% endif %}
                {% for profile in entries.profiles %}
                  {% if profile.url and profile.url != '' %}
                    <dt>{{ profile.network }}</dt>
                    <dd>
                      <a href="{{ profile.url }}">{{ profile.username | default: profile.network }}</a>
                    </dd>
                  {% endif %}
                {% endfor %}
              </dl>
            {% when 'work', 'volunteer', 'education', 'awards', 'certificates', 'publications', 'projects' %}
              <ul class="resume-entries">
                {% for entry in entries %}
                  <li>{% include resume/entry.liquid entry=entry section=section %}</li>
                {% endfor %}
              </ul>
            {% else %}
              <dl>
                {% for entry in entries %}
                  <dt>{{ entry.name | default: entry.language }}</dt>
                  <dd>
                    {{ entry.fluency | default: entry.level | default: entry.reference -}}
                    {%- if entry.keywords %}{{ entry.keywords | join: ', ' }}{% endif %}
                  </dd>
                {% endfor %}
              </dl>
          {% endcase %}
        </section>
      {% endif %}
    {% endfor %}
  </div>
</div>
