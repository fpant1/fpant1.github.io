<header class="site-header">
  <nav class="site-nav site-container" id="navbar" aria-label="Main navigation">
    <a class="site-brand" href="{{ '/' | relative_url }}">
      {% if site.title == 'blank' %}
        {{ site.first_name }}
        {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </a>
    <button class="site-menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" hidden>
      <span>Menu</span><span aria-hidden="true">☰</span>
    </button>
    <div class="site-navigation" id="site-navigation">
      <ul class="site-nav-links">
        {% for item in site.data.navigation %}
          {% assign is_active = false %}
          {% if item.url == '/' %}
            {% if page.url == '/' %}{% assign is_active = true %}{% endif %}
          {% else %}
            {% assign url_prefix = page.url | slice: 0, item.url.size %}
            {% if url_prefix == item.url %}{% assign is_active = true %}{% endif %}
          {% endif %}
          <li>
            <a
              class="site-nav-link"
              href="{{ item.url | relative_url }}"
              {% if is_active %}
                aria-current="page"
              {% endif %}
            >
              {{- item.title -}}
            </a>
          </li>
        {% endfor %}
      </ul>
      {% if site.enable_darkmode %}
        <button class="site-theme-toggle" id="light-toggle" type="button" aria-label="Change colour theme" title="Change colour theme">
          <svg class="site-theme-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <g class="site-theme-icon__sun">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"></path>
            </g>
            <path class="site-theme-icon__moon" d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"></path>
          </svg>
        </button>
      {% endif %}
    </div>
  </nav>
</header>
